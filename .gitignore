# =============================================================================
# tool-overuse .gitignore
# =============================================================================
# Repo is structured for end-to-end reproduction of:
#   1. SFT training of the PRM (finetuning/)
#   2. mini-swe-agent inference with a served PRM critic (scripts/, mini-swe-agent/)
# Anything not on those two paths is excluded below.
# =============================================================================

# --- Local environment / caches ---
.venv/
.claude/
*.claude
__pycache__/
*.pyc

# --- Local archive dump (kept on disk, never pushed) ---
# Use _archive/ to stash scripts/files we don't want in the handover but
# don't want to delete either. Mirrors source layout (e.g. _archive/scripts/foo.py).
_archive/

# --- Leaked / nested git internals ---
mini-swe-agent/.git.backup/
**/.git.backup/

